{
  "name": "seraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "bot": "node --env-file-if-exists=.env src/bot.ts",
    "controller": "node --env-file-if-exists=.env src/bot.ts",
    "controller:dev": "node --watch --env-file-if-exists=.env src/bot.ts",
    "dashboard": "node --env-file-if-exists=.env src/operator/dashboard.ts",
    "test": "node --test test/*.test.ts",
    "test:mod": "DOTNET_CLI_HOME=$PWD/.runtime/dotnet-home .dotnet/dotnet run --project test/mod/ModTests.csproj",
    "control": "node scripts/control.ts",
    "game": "node scripts/game.ts",
    "worktree": "node scripts/worktree.ts",
    "setup:linux": "bash scripts/setup-linux.sh",
    "goal:gather": "node scripts/gather.ts",
    "report:dev": "pnpm --filter seraph-fleet run dev",
    "report:deploy": "pnpm --filter seraph-fleet run deploy",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.13.4",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  }
}
