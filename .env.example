# Copy to .env. Existing environment variables override this file.
# Existing bot save basename, without .vcdbs. Takes precedence over SERVER.
VINTAGE_STORY_WORLD=
# Bot profile name; multiplayer servers may enforce the authenticated account name.
VINTAGE_STORY_CHARACTER_NAME=
# Used when WORLD is empty. Host or host:port.
VINTAGE_STORY_SERVER=
# Quote passwords containing # or whitespace. Passed via the game's --pw option.
VINTAGE_STORY_SERVER_PASSWORD=
# Headless X display managed by scripts/game.mjs.
VINTAGE_STORY_DISPLAY=
# Fleet report service (report/). Empty URL disables reporting. Token must equal the Worker's REPORT_TOKEN secret.
VINTAGE_STORY_REPORT_URL=
VINTAGE_STORY_REPORT_TOKEN=
# Bot identity shown in the fleet view; defaults to the hostname. Letters, digits, . _ - only.
VINTAGE_STORY_BOT_ID=
# Public https URL where this host's live view (mediamtx HLS, port 8888) is reachable, e.g. a Cloudflare Tunnel hostname.
# Reported with the bot's identity so the fleet page can embed it. Empty means no remote live view.
VINTAGE_STORY_STREAM_URL=
